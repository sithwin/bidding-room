# Local-testing overrides for `docker-compose.test.yml` ONLY.
#
# Every var in docker-compose.test.yml has an inline `${VAR:-default}`
# fallback, so this file only needs to hold the values that should differ
# from those defaults for a local E2E run. Docker Compose's `--env-file`
# flag REPLACES (not merges) the ambient root `.env` for the invocation, so
# using this file also prevents the root `.env` (which holds dev/production
# secrets such as STRIPE_WEBHOOK_SECRET) from silently leaking into the test
# stack — see docs/superpowers/... E2E debugging session for the incident
# this fixed (a real Turnstile key + a mismatched Stripe webhook secret from
# the shared root .env both broke local E2E runs while CI stayed green,
# because CI never loads the root .env at all).
#
# Usage:
#   docker compose --env-file .env.test -f docker-compose.test.yml up -d --build
#
# Mirrors the values ci.yml's "Run E2E suite with coverage" step sets as
# job-level env vars (kept as a separate mechanism there deliberately — see
# ci.yml's own comment: one CI job also asserts the strict production
# rate-limit ceiling actually trips, so it cannot use a blanket override).

# Strict tier: login, register, verify-email, phone OTP request/verify.
# Production default is 10 req/min per IP — too low for a single E2E suite
# run, which creates many throwaway accounts from one container IP.
USER_AUTH_STRICT_RATE_LIMIT_MAX=1000
CATALOGUE_DEFAULT_RATE_LIMIT_MAX=1000
AUCTION_ENGINE_BID_RATE_LIMIT_MAX=1000
AUCTION_ENGINE_DEFAULT_RATE_LIMIT_MAX=1000
PAYMENT_DEFAULT_RATE_LIMIT_MAX=1000
SHIPPING_DEFAULT_RATE_LIMIT_MAX=1000
NOTIFICATION_DEFAULT_RATE_LIMIT_MAX=1000
